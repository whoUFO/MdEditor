    "react-dom": ">=17.0.0"
  },
  "devDependencies": {
    "@markdown-editor/tsconfig": "workspace:*",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@types/dompurify": "^3.0.0",
    "@types/jsdom": "^21.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "typescript": "^6.0.0",
    "vitest": "^3.0.0"
