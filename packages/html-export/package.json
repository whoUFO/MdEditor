{
  "name": "@markdown-editor/html-export",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./templates": "./dist/templates/index.js",
    "./utils": "./dist/utils/index.js",
    "./components": "./dist/components/index.js"
  },
  "scripts": {
